{
  "name": "orynt",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @orynt/desktop dev",
    "desktop": "pnpm --filter @orynt/desktop tauri dev",
    "desktop:build": "pnpm --filter @orynt/desktop tauri build --no-bundle",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm --filter @orynt/desktop lint",
    "typecheck": "pnpm --filter @orynt/desktop typecheck",
    "test": "pnpm --filter @orynt/desktop test",
    "knip": "knip",
    "build": "pnpm --filter @orynt/desktop build"
  },
  "devDependencies": {
    "knip": "6.35.0",
    "prettier": "3.9.6"
  }
}
